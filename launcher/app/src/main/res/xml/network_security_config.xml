<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Preserve existing local LAN and app-published artwork URLs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <!-- Some TV trust stores omit Apple's root. Keep this extra trust on its scene host only. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/apple_root_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
